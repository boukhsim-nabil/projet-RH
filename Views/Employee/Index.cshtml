@model List<supmtigroupe.Areas.Identity.Data.ApplicationUser>
@using Microsoft.AspNetCore.Identity
@using supmtigroupe.Areas.Identity.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject ApplicationUserManager UserManager

@{
    var userRoles = await UserManager.GetRolesAsync(await UserManager.GetUserAsync(User));
    ViewData["Title"] = "Employés";
    ViewData["active"] = "EMP";
}

<!-- Page Header -->
<div class="page-header">
    <div class="row align-items-center">
        <div class="col">
            <h3 class="page-title">Employé</h3>
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="EmpIndex">Dashboard</a></li>
                <li class="breadcrumb-item active">Employé</li>
            </ul>
        </div>
                            @if (!userRoles.Contains("Viewer"))
        {
            <div class="col-auto float-end ms-auto">
                <a id="register" asp-area="Identity" asp-page="/Account/Register" class="btn add-btn"><i class="fa-solid fa-plus"></i> Ajouter Employé</a>
        </div>}
        <div class="col-auto float-end ms-auto">
            <div class="btn-group btn-group-sm">
                <a asp-controller="Employee" asp-action="all_users" class="btn @(ViewBag.status == "All" ? "btn-primary" : "btn-white")"><i class="las la-hourglass-start"></i> Tous</a>
                <a asp-controller="Employee" asp-action="active_users" class="btn @(ViewBag.status == "Active" ? "btn-primary" : "btn-white")"><i class="las la-check-circle"></i> Actif</a>
                <a asp-controller="Employee" asp-action="resign_users" class="btn @(ViewBag.status == "Resign" ? "btn-primary" : "btn-white")"><i class="las la-times-circle"></i> Inactif</a>
            </div>
        </div>

    </div>
</div>
<!-- /Page Header -->
<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table id="example3" class="table table-striped custom-table leave-employee-table mb-0">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Entreprise</th>
                        <th>Mobile</th>
                        <th>Date d'Entrée</th>
                        @if (!userRoles.Contains("Viewer"))
                        {
                            <th>Actions</th>
                        }
                        <th>Email</th>
                        <th>Banque</th>
                        <th>Compte #</th>
                        <th>Nom Père/Conjoint</th>
                        <th>CNIC</th>
                        <th>Date de Naissance</th>
                        <th>Expiration CNIC</th>
                        <th>Passeport #</th>
                        <th>Adresse Actuelle</th>
                        <th>Adresse Permanente</th>
                        <th>Statut Marital</th>
                        <th>Statut</th>
                        <th>Téléphone #</th>
                        <th>Contact d'Urgence #</th>
                        <th>Date d'Entrée</th>
                        <th>Date de Démission</th>
                        <th>Type Employé</th>
                        <th>Salaire</th>
                        <th>Entreprise</th>
                        <th>Département</th>
                        <th>Poste</th>
                        <th>Horaire</th>
                        <th>Type Présence</th>
                        <th>ID Machine</th>
                        <!-- Add more user properties as needed -->
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <h2 class="table-avatar">
                                    <a asp-controller="Employee" asp-action="Profile" asp-route-id="@user.Id" class="avatar"><img src="~/dist/files/@user.profile_pic" alt="User Image"></a>
                                    <a asp-controller ="Employee" asp-action="Profile" asp-route-id="@user.Id">@user.name - <span> @user.designation?.name</span></a>
                                </h2>
                            </td>
                            <td>@user.company?.name</td>
                            <td>@user.PhoneNumber</td>
                            <td>
                                @(user.joining_date.HasValue ? user.joining_date.Value.ToString("dd MMM yyyy") : "")
                            </td>
                            @if (!userRoles.Contains("Viewer"))
                            {
                                <td class="text-end">
                                    <div class="dropdown dropdown-action">
                                    <a href="#" class="action-icon dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="material-icons">more_vert</i></a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a class="dropdown-item" asp-controller="EmpFamily" asp-action="Create" asp-route-id="@user.Id"><i class="fa-solid fa-pencil m-r-5"></i> Relatif</a>
                                        <a class="dropdown-item" asp-controller="Employee" asp-action="Edit" asp-route-id="@user.Id"><i class="fa-solid fa-pencil m-r-5"></i> Modifier</a>
                                    </div>
                                </div>
                            </td>
                            } 
                            <!-- Add more user property cells as needed -->
                            <td>@user.Email</td>
                            <td>@user.bank</td>
                            <td>@user.account</td>
                            <td>@user.f_name</td>
                            <td>@user.cnic</td>
                            <td>@user.cnic_issue</td>
                            <td>@user.cnic_expiry</td>
                            <td>@user.passport</td>
                            <td>@user.curr_address</td>
                            <td>@user.permanent_address</td>
                            <td>@user.marital_status</td>
                            <td>@user.status</td>
                            <td>@user.contact</td>
                            <td>@user.emergency_contact</td>
                            <td>@user.joining_date</td>
                            <td>@user.resignation_date</td>
                            <td>@user.emp_type</td>
                            <td>@user.salary</td>
                            <td>@user.company?.name</td>
                            <td>@user.depart?.name</td>
                            <td>@user.designation?.name</td>
                            <td>@user.shift?.from - @user.shift?.to</td>
                            <td>@user.attend_type</td>
                            <td>@user.machineId</td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>